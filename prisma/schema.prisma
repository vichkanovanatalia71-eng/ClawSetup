generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  EDITOR
  ADMIN
  SUPERADMIN
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELED
  UNPAID
  TRIALING
}

enum StepStatus {
  DRAFT
  PUBLISHED
}

enum Difficulty {
  BEGINNER
  INTERMEDIATE
  ADVANCED
}

model User {
  id               String    @id @default(cuid())
  name             String?
  email            String    @unique
  emailVerified    DateTime?
  image            String?
  passwordHash     String?
  role             Role      @default(USER)
  currentStreak    Int       @default(0)
  longestStreak    Int       @default(0)
  lastActiveDate   DateTime?
  referralCode     String?   @unique
  referredBy       String?
  emailPreferences Json      @default("{\"weeklyDigest\":true}")
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @updatedAt
  lastLoginAt      DateTime?

  accounts      Account[]
  sessions      Session[]
  subscription  Subscription?
  progress      UserProgress[]
  aiTickets     AITicket[]
  auditLogs     AuditLog[]
  certificates  Certificate[]
  bookmarks     Bookmark[]
  notifications Notification[]
  referrals     Referral[]     @relation("Referrer")
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Subscription {
  id                   String             @id @default(cuid())
  userId               String             @unique
  stripeCustomerId     String?            @unique
  stripeSubscriptionId String?            @unique
  stripePriceId        String?
  status               SubscriptionStatus @default(ACTIVE)
  plan                 String             @default("monthly")
  currentPeriodStart   DateTime?
  currentPeriodEnd     DateTime?
  cancelAtPeriodEnd    Boolean            @default(false)
  dunningEmailsSent    Int                @default(0)
  createdAt            DateTime           @default(now())
  updatedAt            DateTime           @updatedAt

  user     User      @relation(fields: [userId], references: [id], onDelete: Cascade)
  payments Payment[]

  @@index([status])
  @@index([stripeCustomerId])
  @@index([updatedAt])
}

model Payment {
  id               String   @id @default(cuid())
  subscriptionId   String
  stripePaymentId  String?  @unique
  amount           Int
  currency         String   @default("usd")
  status           String
  invoiceUrl       String?
  createdAt        DateTime @default(now())

  subscription Subscription @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)
}

model Scenario {
  id          String   @id @default(cuid())
  slug        String   @unique
  name        String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  modules      Module[]
  certificates Certificate[]
}

model Module {
  id          String   @id @default(cuid())
  scenarioId  String
  title       String
  description String?  @db.Text
  order       Int      @default(0)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)
  steps    Step[]
}

model Step {
  id              String     @id @default(cuid())
  moduleId        String
  title           String
  slug            String
  goal            String?    @db.Text
  prerequisites   String?    @db.Text
  contentMd       String     @db.Text
  expectedResult  String?    @db.Text
  commonErrors    String?    @db.Text
  order           Int        @default(0)
  version         Int        @default(1)
  status          StepStatus @default(DRAFT)
  difficulty      Difficulty @default(BEGINNER)
  tags            String[]
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt

  module   Module    @relation(fields: [moduleId], references: [id], onDelete: Cascade)
  subSteps SubStep[]
  media    Media[]
  imagePrompts ImagePrompt[]
  progress UserProgress[]
  aiTickets AITicket[]
  troubleshootTrees TroubleshootTree[]

  @@unique([moduleId, slug])
}

model SubStep {
  id        String   @id @default(cuid())
  stepId    String
  title     String
  contentMd String   @db.Text
  order     Int      @default(0)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model Media {
  id       String  @id @default(cuid())
  stepId   String
  type     String  @default("image")
  url      String
  alt      String?
  order    Int     @default(0)

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model ImagePrompt {
  id               String  @id @default(cuid())
  stepId           String
  promptText       String  @db.Text
  styleNotes       String?
  requiredElements String? @db.Text
  order            Int     @default(0)

  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)
}

model UserProgress {
  id          String   @id @default(cuid())
  userId      String
  stepId      String
  completed   Boolean  @default(false)
  completedAt DateTime?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
  @@index([stepId])
  @@index([userId, completed])
}

model AITicket {
  id           String   @id @default(cuid())
  userId       String
  stepId       String
  inputText    String?  @db.Text
  imageRef     String?
  aiAnswer     String?  @db.Text
  inputTokens  Int?
  outputTokens Int?
  tags         String[]
  rating       Int?
  createdAt    DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
  step Step @relation(fields: [stepId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@index([stepId])
  @@index([createdAt])
  @@index([userId, createdAt])
}

model Conversation {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  messages  Json     @default("[]")
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stepId])
  @@index([userId])
}

model UserNote {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  content   String   @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([userId, stepId])
  @@index([userId])
}

model StepFeedback {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  helpful   Boolean
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@unique([userId, stepId])
  @@index([stepId])
}

model Certificate {
  id              String   @id @default(cuid())
  userId          String
  scenarioId      String
  completedAt     DateTime @default(now())
  certificateHash String   @unique
  createdAt       DateTime @default(now())

  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  scenario Scenario @relation(fields: [scenarioId], references: [id], onDelete: Cascade)

  @@unique([userId, scenarioId])
  @@index([userId])
}

model StepEvent {
  id         String   @id @default(cuid())
  userId     String
  stepId     String
  event      String
  durationMs Int?
  createdAt  DateTime @default(now())

  @@index([userId])
  @@index([stepId])
  @@index([createdAt])
}

model SupportTicket {
  id         String   @id @default(cuid())
  userId     String
  stepId     String?
  subject    String
  message    String   @db.Text
  aiSnapshot Json?
  status     String   @default("OPEN")
  adminNotes String?  @db.Text
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt

  @@index([userId])
  @@index([status])
}

model NPSResponse {
  id        String   @id @default(cuid())
  userId    String
  score     Int
  comment   String?  @db.Text
  createdAt DateTime @default(now())

  @@index([userId])
  @@index([createdAt])
}

model TroubleshootTree {
  id        String   @id @default(cuid())
  stepId    String
  title     String
  createdAt DateTime @default(now())

  step  Step               @relation(fields: [stepId], references: [id], onDelete: Cascade)
  nodes TroubleshootNode[]

  @@index([stepId])
}

model TroubleshootNode {
  id       String  @id @default(cuid())
  treeId   String
  parentId String?
  question String  @db.Text
  answer   String? @db.Text
  isLeaf   Boolean @default(false)
  order    Int     @default(0)

  tree TroubleshootTree @relation(fields: [treeId], references: [id], onDelete: Cascade)

  @@index([treeId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  entity    String
  entityId  String?
  details   String?
  before    Json?
  after     Json?
  ip        String?
  userAgent String?
  createdAt DateTime @default(now())

  actor User? @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([actorId])
  @@index([createdAt])
  @@index([entity])
}

model Bookmark {
  id        String   @id @default(cuid())
  userId    String
  stepId    String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, stepId])
  @@index([userId])
}

model Notification {
  id        String   @id @default(cuid())
  userId    String
  type      String
  title     String
  message   String   @db.Text
  read      Boolean  @default(false)
  actionUrl String?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, read])
  @@index([createdAt])
}

model Referral {
  id            String   @id @default(cuid())
  referrerId    String
  referredId    String   @unique
  rewardApplied Boolean  @default(false)
  createdAt     DateTime @default(now())

  referrer User @relation("Referrer", fields: [referrerId], references: [id], onDelete: Cascade)

  @@index([referrerId])
}
